{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-idea.local/schemas/evidence-record.schema.json",
  "title": "App Idea Research Evidence Record v4.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "claim_id",
    "idea_id",
    "phase",
    "source_type",
    "source_title",
    "source_url",
    "source_ref",
    "artifact_path",
    "independence_root",
    "collected_at",
    "data_period",
    "geo",
    "storefront",
    "platform",
    "status",
    "observation",
    "value",
    "unit",
    "evidence_level",
    "observation_quality",
    "claim_relevance",
    "direction",
    "sample_n",
    "denominator",
    "limitations",
    "search_queries",
    "attempted_sources"
  ],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "claim_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "idea_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "phase": {"type": "string", "pattern": "^(preflight|[1-9]|10|5\\.5|post_mvp)$"},
    "source_type": {
      "enum": [
        "official_primary",
        "marketplace_primary",
        "ad_library",
        "first_party",
        "third_party_estimate",
        "community",
        "interview",
        "experiment",
        "user_input",
        "local_artifact",
        "synthetic"
      ]
    },
    "source_title": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "source_ref": {"type": ["string", "null"]},
    "artifact_path": {"type": ["string", "null"]},
    "independence_root": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "collected_at": {"type": "string", "format": "date"},
    "data_period": {"type": ["string", "null"]},
    "geo": {"type": ["string", "null"]},
    "storefront": {"type": ["string", "null"]},
    "platform": {"type": ["string", "null"]},
    "status": {
      "enum": ["observed", "not_found_after_protocol", "structurally_unobservable", "not_applicable"]
    },
    "observation": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "value": {},
    "unit": {"type": ["string", "null"]},
    "evidence_level": {"enum": ["E0", "E1", "E2", "E3", "E4"]},
    "observation_quality": {"enum": ["direct", "estimated", "inferred"]},
    "claim_relevance": {"enum": ["direct", "supporting", "weak"]},
    "direction": {"enum": ["supports", "contradicts", "neutral"]},
    "sample_n": {"type": ["integer", "null"], "minimum": 0},
    "denominator": {"type": ["integer", "number", "string", "null"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "search_queries": {"type": "array", "items": {"type": "string"}},
    "attempted_sources": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "description": "source_url, source_ref or artifact_path is required",
      "anyOf": [
        {"properties": {"source_url": {"type": "string", "pattern": "\\S"}}},
        {"properties": {"source_ref": {"type": "string", "pattern": "\\S"}}},
        {"properties": {"artifact_path": {"type": "string", "pattern": "\\S"}}}
      ]
    },
    {
      "description": "not_found_after_protocol requires searches and attempted sources",
      "if": {"properties": {"status": {"const": "not_found_after_protocol"}}},
      "then": {
        "properties": {
          "search_queries": {"minItems": 1},
          "attempted_sources": {"minItems": 1}
        }
      }
    },
    {
      "description": "web evidence requires a source_url",
      "if": {"properties": {"source_type": {"enum": ["official_primary", "marketplace_primary", "ad_library", "third_party_estimate", "community"]}}},
      "then": {"properties": {"source_url": {"type": "string"}}}
    },
    {
      "description": "synthetic evidence must be E0",
      "if": {"properties": {"source_type": {"const": "synthetic"}}},
      "then": {"properties": {"evidence_level": {"const": "E0"}}}
    },
    {
      "description": "ad_library evidence must be E1 or E2",
      "if": {"properties": {"source_type": {"const": "ad_library"}}},
      "then": {"properties": {"evidence_level": {"enum": ["E1", "E2"]}}}
    }
  ]
}
